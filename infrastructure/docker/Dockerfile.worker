FROM node:22-alpine AS base
WORKDIR /app
COPY package.json package-lock.json* pnpm-lock.yaml* turbo.json* tsconfig*.json ./
COPY packages ./packages
COPY apps/worker ./apps/worker
RUN npm install --workspaces --if-present || npm install
COPY . .
RUN npm run build --workspace=@erp/worker || npm run build
ENV NODE_ENV=production
CMD ["node", "apps/worker/dist/apps/worker/src/index.js"]
