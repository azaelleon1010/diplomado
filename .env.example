# TramaTech ERP — environment template (NO real secrets here).
# Copy to .env and fill values. Never commit .env.

NODE_ENV=development
PORT=3000

# MongoDB Atlas — System of Record (REQUIRED, no default).
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=erp_platform

# Auth — JWT_SECRET is REQUIRED in production (min 32 chars) and must be long and random.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Seed for the initial TRAMATECH administrator (used by `npm run seed:identity --workspace @erp/api`).
# SEED_ADMIN_PASSWORD is required to run the seed and is never logged.
# SEED_TENANT_ID=TRAMATECH
# SEED_ADMIN_EMAIL=admin@tramatech.mx
# SEED_ADMIN_PASSWORD=

# Redis stays disabled. Auth does not require Redis.
REDIS_ENABLED=false
# Proxy hops for req.ip ("true", "false" or a number). Unset: 1 in production, none otherwise.
# TRUST_PROXY=1
# Public auth endpoint limits (fixed window, in-memory per instance)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_MAX_PER_ACCOUNT=10
AUTH_LOGIN_MAX_PER_IP=100
AUTH_REGISTER_MAX_PER_IP=10
AUTH_PUBLIC_MAX_PER_IP=300
# Password reset link TTL and limits (fixed window, in-memory per instance)
AUTH_PASSWORD_RESET_TTL_MINUTES=60
AUTH_PASSWORD_RESET_MAX_PER_IP=20
AUTH_PASSWORD_RESET_MAX_PER_ACCOUNT=5

# Resend — required to send the welcome email and the password-reset email.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# Base URL of the deployed Web app. Used to build the link sent in the
# password-reset email (<WEB_APP_URL>/reset-password?rid=...&token=...).
WEB_APP_URL=http://localhost:5173
